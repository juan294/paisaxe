{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/route.ts",
    "src/app/**/loading.tsx",
    "src/app/**/error.tsx",
    "src/app/providers.tsx",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "ignore": [
    "src/test/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "du",
    "cloudflared",
    "openssl",
    "supabase",
    "psql"
  ],
  "paths": {
    "@/*": [
      "./src/*"
    ]
  },
  "next": {
    "entry": [
      "next.config.ts",
      "src/app/**/page.tsx",
      "src/app/**/layout.tsx",
      "src/app/**/route.ts",
      "src/app/**/loading.tsx",
      "src/app/**/error.tsx",
      "src/app/robots.ts",
      "src/app/sitemap.ts",
      "src/proxy.ts"
    ]
  },
  "vitest": {
    "entry": [
      "src/**/*.test.{ts,tsx}",
      "src/test/setup.ts"
    ]
  }
}
