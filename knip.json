{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/route.ts",
    "src/app/**/loading.tsx",
    "src/app/**/error.tsx",
    "src/app/providers.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/test/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "license-checker",
    "GPL-3.0",
    "AGPL-1.0",
    "AGPL-3.0",
    "EUPL-1.1",
    "EUPL-1.2",
    "SSPL-1.0",
    "BSL-1.1",
    "CPAL-1.0",
    "OSL-3.0",
    "CPOL-1.02",
    "du",
    "elevenlabs",
    "cloudflared"
  ],
  "paths": {
    "@/*": ["./src/*"]
  },
  "next": {
    "entry": [
      "next.config.ts",
      "src/app/**/page.tsx",
      "src/app/**/layout.tsx",
      "src/app/**/route.ts",
      "src/app/**/loading.tsx",
      "src/app/**/error.tsx",
      "src/app/robots.ts",
      "src/app/sitemap.ts",
      "src/proxy.ts"
    ]
  },
  "vitest": {
    "entry": [
      "src/**/*.test.{ts,tsx}",
      "src/test/setup.ts"
    ]
  }
}
