{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/juan/code/paisaxe/.codex/hooks/guard-bash.sh'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/juan/code/paisaxe/.codex/hooks/lint-fix.sh'",
            "timeout": 30,
            "statusMessage": "Auto-fixing lint..."
          }
        ]
      }
    ]
  }
}
