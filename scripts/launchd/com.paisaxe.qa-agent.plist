<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.paisaxe.qa-agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/juan/Documents/code/paisaxe/scripts/qa-agent.sh</string>
    </array>

    <!-- Run every Sunday at 8:00 AM local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/juan/Documents/code/paisaxe/logs/qa-agent-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/juan/Documents/code/paisaxe/logs/qa-agent-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <!-- Don't run missed jobs immediately on wake -->
    <key>StartInterval</key>
    <false/>
</dict>
</plist>
