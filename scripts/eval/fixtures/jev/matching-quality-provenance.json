  "candidateOrder": {
    "predeclaredSeed": "paisaxe-independent-quality-v1-2026-10-29",
    "rule": "For each case assign price rank by ascending hexadecimal SHA256(UTF8(seed + colon + caseId + colon + optionId)); price=1600+700*rank. Then stable-sort catalog by suitable, unconfirmed, rejected and ascending price, using ID as deterministic final tie-break. Rejected over-budget trap uses 9500 cents.",
    "declaration": "Seed and rule communicated to parent before writing reference judgments; no resampling, no order edits based on expected or observed model behavior.",
    "semanticInputsExcludedFromOrder": [
      "preference",
      "description",
      "reference labels",
      "model outputs"
    ]
  },
