# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_KEY=eyJxxxxx

# Voyage AI (embeddings)
VOYAGE_API_KEY=pa-xxxxx

# ElevenLabs (voice agents - optional)
ELEVENLABS_API_KEY=sk-xxxxx
ELEVENLABS_WEBHOOK_SECRET=              # ElevenLabs webhook signature verification
ELEVENLABS_PHONE_NUMBER_ID=             # ElevenLabs phone number ID for outbound booking calls
ELEVENLABS_BOOKING_AGENT_ID=            # ElevenLabs booking agent ID (NOT Pelayo — dedicated booking agent)

# GitHub (traffic analytics)
# Create a PAT with `repo` scope at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxx

# Maintenance Mode
# Controls whether visitors see the "Coming Soon" page
# Priority: ENV var > Database flag
#   - "true"  = Always show Coming Soon (overrides database)
#   - "false" = Never show Coming Soon (overrides database)
#   - unset   = Use database flag (toggle from admin panel)
# Admin, API, and auth routes always bypass maintenance mode
# MAINTENANCE_MODE=true

# Google OAuth (used by Supabase Auth for admin panel)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# MCP tool authentication
MCP_API_SECRET=                         # Shared secret for authenticating MCP tool requests

# Voice Agent MCP Tools (optional - enables weather and places features)
# OpenWeatherMap: Get free API key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your-openweathermap-key
# Google Places: Enable Places API at https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=your-google-places-key

# Stripe (payments)
# Get your API keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# Create a webhook endpoint at https://dashboard.stripe.com/webhooks
# pointing to /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# Create a product and price in Stripe Dashboard
# Get the Price ID from the price details page
STRIPE_DAY_PASS_PRICE_ID=price_xxxxx

# Supabase Webhooks
WEBHOOK_SECRET=whsec_xxxxx

# Site URL (used for auth callbacks and absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Twilio (SMS alerts, voice booking)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+1234567890
QA_ALERT_PHONE=+34612345678

# Credentials encryption
CREDENTIALS_ENCRYPTION_KEY=             # Encryption key for stored credentials

# Resend (transactional email)
RESEND_API_KEY=re_xxxxx
ADMIN_EMAIL=admin@paisaxe.es

# Upstash Redis (distributed rate limiting - optional)
# When set, rate limiting uses Redis instead of in-memory (recommended for production)
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=                 # Upstash Redis REST URL
UPSTASH_REDIS_REST_TOKEN=               # Upstash Redis REST token

# Vercel Cron (required for scheduled jobs)
# Vercel automatically sets this for cron invocations
# For local testing, set any random string
CRON_SECRET=                            # Vercel Cron authentication secret

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=                # PostHog analytics project key (client-side)
NEXT_PUBLIC_POSTHOG_HOST=               # PostHog analytics host URL (client-side)
POSTHOG_PROJECT_ID=                     # PostHog project ID for server-side analytics API
POSTHOG_PERSONAL_API_KEY=               # PostHog personal API key for server-side analytics API

# Agent execution (optional)
# When set to any truthy value, allows running agents via the admin API outside development mode
# ALLOW_AGENT_RUN=true

# QA test runner (optional - used by llm-quality.test.ts)
# QA_TESTS_PER_CATEGORY=3
# QA_REPORT_FILE=qa-report.json

# Sentry error tracking (optional — skip init if not set)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
# SENTRY_ORG=your-org
# SENTRY_PROJECT=paisaxe
