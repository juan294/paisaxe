# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Force the Anthropic transport (src/lib/claude.ts) instead of the default
# NODE_ENV-based choice (curl outside production, SDK in production). Valid
# values: "sdk" or "curl". Leave unset for the default behavior.
# ANTHROPIC_TRANSPORT=sdk

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
# The only service-role credential the app reads (src/lib/env.ts). A previously
# documented SUPABASE_SERVICE_ROLE_KEY alias has been removed (#865) — it was
# never actually set in any real environment (production, preview, or local),
# so the fallback was resolving silently through this name alone anyway.
SUPABASE_SERVICE_KEY=eyJxxxxx
# Storage limit (MB) used by /api/health to compute database usage percentage.
# Defaults to 8192 (Supabase Pro: 8 GB). Update when upgrading your Supabase plan.
SUPABASE_STORAGE_LIMIT_MB=8192

# Local Docker Supabase overrides (used only by src/test/local-supabase.ts, which
# backs live-RLS integration tests like *.postgrest-rls.test.ts). All three have
# working defaults matching a stock `supabase start` — only set these if your
# local stack uses a non-default port, anon key, or container name.
# SUPABASE_LOCAL_REST_URL=http://127.0.0.1:54321/rest/v1
# SUPABASE_LOCAL_ANON_KEY=eyJxxxxx
# SUPABASE_LOCAL_DB_CONTAINER=supabase_db_paisaxe
# SUPABASE_LOCAL_API_URL=http://127.0.0.1:54321
# SUPABASE_LOCAL_SERVICE_ROLE_KEY=eyJxxxxx

# Voyage AI (embeddings)
VOYAGE_API_KEY=pa-xxxxx

# ElevenLabs (voice agents - optional)
ELEVENLABS_API_KEY=sk-xxxxx
ELEVENLABS_API_KEY_FINGERPRINT=sha256:0000000000000000 # Safe identity of the runtime key; required in production
ELEVENLABS_WEBHOOK_SECRET=              # ElevenLabs webhook signature verification
ELEVENLABS_PHONE_NUMBER_ID=             # ElevenLabs phone number ID for outbound booking calls
ELEVENLABS_BOOKING_AGENT_ID=            # ElevenLabs booking agent ID (NOT Pelayo — dedicated booking agent)

# GitHub (traffic analytics)
# Create a PAT with `repo` scope at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxx

# Maintenance Mode
# Controls whether visitors see the "Coming Soon" page
# Priority: ENV var > Database flag
#   - "true"  = Always show Coming Soon (overrides database)
#   - "false" = Never show Coming Soon (overrides database)
#   - unset   = Use database flag (toggle from admin panel)
# Admin, API, and auth routes always bypass maintenance mode
# MAINTENANCE_MODE=true

# Google OAuth (used by Supabase Auth for admin panel)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# MCP tool authentication
MCP_API_SECRET=                         # Shared secret for authenticating MCP tool requests

# Voice Agent MCP Tools (optional - enables weather and places features)
# OpenWeatherMap: Get free API key at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your-openweathermap-key
# Google Places: Enable Places API at https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=your-google-places-key

# Stripe (payments)
# Get your API keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# Create a webhook endpoint at https://dashboard.stripe.com/webhooks
# pointing to /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# Create a product and price in Stripe Dashboard for each of the three tiers
# Get the Price ID from the price details page
STRIPE_DAY_PASS_PRICE_ID=price_xxxxx
STRIPE_WEEKLY_PRICE_ID=price_xxxxx
STRIPE_MONTHLY_PRICE_ID=price_xxxxx

# PayPal (experience deposits; SANDBOX only until a reviewed production decision)
# Developer dashboard: https://developer.paypal.com/dashboard/applications/sandbox
# Read by src/lib/paypal/env.ts, which accepts only the sandbox host.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id of the sandbox listener (a tunnel in development; a production listener only after the reviewed production decision)
# PAYPAL_WEBHOOK_ID=

# Experience booking capability links (HMAC key, at least 32 bytes; generate with
# `openssl rand -base64 48`). Rotating it revokes every booking and operator link.
# BOOKING_LINK_SECRET=

# Stripe E2E integration tests (used by scripts/run-stripe-e2e.ts and .github/workflows/e2e-stripe-integration.yml)
# These use Stripe test-mode keys — different from the live keys above.
# Set these as GitHub repository secrets for CI; provide locally only when running npm run test:e2e:stripe.
STRIPE_TEST_SECRET_KEY=sk_test_xxxxx
STRIPE_TEST_DAY_PASS_PRICE_ID=price_xxxxx
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_TEST_WEBHOOK_SECRET=whsec_xxxxx

# QA test user credentials (used by Stripe E2E and other integration tests)
# Create a dedicated test user in Supabase Auth for CI use — never use a real account.
QA_TEST_USER_EMAIL=qa-test@example.com
QA_TEST_USER_PASSWORD=

# Supabase Webhooks
WEBHOOK_SECRET=whsec_xxxxx

# Site URL (used for auth callbacks and absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=                       # Canonical app URL (overrides VERCEL_URL in production; set to https://paisaxe.es)
VERCEL_URL=                                # Auto-set by Vercel (deployment URL); fallback when NEXT_PUBLIC_APP_URL is unset

# Twilio (SMS alerts, voice booking)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+1234567890
QA_ALERT_PHONE=+34612345678

# Credentials encryption
CREDENTIALS_ENCRYPTION_KEY=             # Encryption key for stored credentials

# Resend (transactional email)
RESEND_API_KEY=re_xxxxx
ADMIN_EMAIL=admin@paisaxe.es

# Upstash Redis (distributed rate limiting - optional)
# When set, rate limiting uses Redis instead of in-memory (recommended for production)
# Create a free database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=                 # Upstash Redis REST URL
UPSTASH_REDIS_REST_TOKEN=               # Upstash Redis REST token

# Vercel Cron (required for scheduled jobs)
# Vercel automatically sets this for cron invocations
# For local testing, set any random string
CRON_SECRET=                            # Vercel Cron authentication secret
HEALTH_PROBE_SECRET=                    # Separate bearer for authorized deep-health and release preflight

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=                # PostHog analytics project key (client-side)
NEXT_PUBLIC_POSTHOG_HOST=               # PostHog analytics host URL (client-side)
POSTHOG_PROJECT_ID=                     # PostHog project ID for server-side analytics API
POSTHOG_PERSONAL_API_KEY=               # PostHog personal API key for server-side analytics API

# Agent execution (optional)
# When set to any truthy value, allows running agents via the admin API outside development mode
# ALLOW_AGENT_RUN=true

# QA test runner (optional - used by llm-quality.test.ts)
# QA_TESTS_PER_CATEGORY=3
# QA_REPORT_FILE=qa-report.json

# Sentry error tracking (required for preview and production — errors are invisible without this)
# Get your DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
SENTRY_ORG=your-org
SENTRY_PROJECT=paisaxe

# Playwright E2E test origin (CI/test only — do NOT set in production or preview)
# Set automatically by playwright.config.ts webServer.env to allow the test server
# origin through CSRF origin validation during E2E test runs.
# PLAYWRIGHT_TEST_ORIGIN=http://localhost:3100
# Optional JSON reporter destination used by the Stripe E2E wrapper in CI.
# PLAYWRIGHT_JSON_OUTPUT_NAME=test-results/stripe-e2e-report.json

# Turbopack (local dev only — do NOT set in production or preview)
# When set to "1", the app is running under `next dev --turbopack`.
# The chat routes use this to detect the Turbopack build environment where
# static co-bundling of the AI stack (claude/embeddings/search/supabase) can
# corrupt outbound HTTPS to api.anthropic.com. Unset in all deployed envs.
# TURBOPACK=1

# Release verification (Wave A)
# VERCEL_GIT_COMMIT_SHA is auto-set by Vercel at build time; /api/health reports it as the
# deployment's build identity so a release can be bound to the tree it was built from.
# Degrades to "unknown" off Vercel — never set it by hand.
# VERCEL_GIT_COMMIT_SHA=
#
# Optional short tree hash injected at build time. Verification does not depend on it: the tree
# is re-derived locally from the reported commit. Degrades to "unknown".
# BUILD_TREE_HASH=
#
# Vercel protection bypass, used by scripts/release/candidate-identity.ts and
# scripts/check-health-readiness.mjs to probe protected Preview deployments.
# Read-only use; never required for production.
# VERCEL_AUTOMATION_BYPASS_SECRET=
#
# RELEASE_TARGET_URL (not an app env var) names the origin the deployed release probes verify:
#   RELEASE_TARGET_URL=https://paisaxe.es npx playwright test --project=release-required
# Unset means the probes fail rather than silently verifying localhost.
