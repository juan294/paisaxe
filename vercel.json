{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/github-traffic-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/content-discovery",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/subscription-optimizer",
      "schedule": "0 4 * * 1"
    }
  ],
  "_comment_redirects": "Defense-in-depth: these CDN-level redirects duplicate the canonical-domain logic in src/proxy.ts handleCanonicalDomain(). Both layers are intentional — Vercel redirects catch requests before the app boots, while the proxy handles any that slip through (e.g., preview deployments, direct IP access).",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "paisaxe.com"
        }
      ],
      "destination": "https://paisaxe.es/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.paisaxe.com"
        }
      ],
      "destination": "https://paisaxe.es/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.paisaxe.es"
        }
      ],
      "destination": "https://paisaxe.es/:path*",
      "permanent": true
    }
  ]
}
