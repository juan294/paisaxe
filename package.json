{
  "name": "paisaxe",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev --port 3006",
    "build": "next build",
    "analyze": "ANALYZE=true NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build --webpack",
    "build:analyze": "ANALYZE=true NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build --webpack",
    "check-bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "generate-locale-coverage": "tsx scripts/generate-locale-coverage.ts",
    "start": "next start",
    "lint": "npm run lint:src && npm run lint:scripts",
    "lint:src": "eslint src/ --max-warnings=0",
    "lint:scripts": "eslint scripts --max-warnings=0",
    "lint:deps": "npx --yes madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
    "typecheck": "npm run typecheck:app && npm run typecheck:scripts && npm run typecheck:e2e && npm run typecheck:edge",
    "typecheck:app": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck:edge": "tsc --noEmit -p supabase/functions/tsconfig.json",
    "check-verification-coverage": "tsx scripts/check-verification-coverage.ts",
    "check-env": "tsx scripts/check-env.ts",
    "check-migrations": "tsx scripts/check-migrations.ts",
    "eval:booking": "tsx --conditions=react-server scripts/eval/booking-eval.ts",
    "check-licenses": "tsx scripts/check-production-licenses.ts",
    "check-secret-inventory": "tsx scripts/check-secret-inventory.ts",
    "check-required-probes": "tsx scripts/release/required-probes.ts",
    "check-elevenlabs-voice": "node scripts/release/check-elevenlabs-voice-preflight.mjs",
    "what-would-ship": "tsx scripts/release/what-would-ship.ts",
    "verify-sentry-delivery": "tsx scripts/verify-sentry-delivery.ts",
    "analyze-release": "tsx scripts/release/analyze-release-run.ts",
    "test": "vitest run",
    "test:ci-cadence": "node --test \"scripts/*.test.mjs\"",
    "check:ci-cadence": "node scripts/validate-ci-cadence-fixtures.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=qa-journey",
    "test:e2e:ui": "playwright test --ui --project=desktop --project=mobile",
    "test:e2e:headed": "playwright test --headed --project=desktop --project=mobile",
    "test:e2e:debug": "playwright test --debug --project=desktop --project=mobile",
    "test:e2e:dev": "PLAYWRIGHT_USE_DEV_SERVER=true PLAYWRIGHT_REUSE_SERVER=true playwright test --project=desktop --project=mobile --project=qa-journey",
    "test:e2e:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:e2e:release-artifact": "playwright test --project=release-required-local --project=release-artifact-smoke",
    "test:e2e:stripe": "tsx scripts/run-stripe-e2e.ts",
    "test:e2e:prelaunch": "tsx scripts/run-prelaunch-e2e.ts",
    "prelaunch": "tsx scripts/run-prelaunch-gate.ts",
    "prelaunch:live": "REQUIRE_LIVE_INTEGRATION=true npm run test:e2e:stripe",
    "test:e2e:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "test:qa": "vitest run --config vitest.config.qa.ts --reporter=verbose",
    "process-pdfs": "tsx scripts/process-pdfs.ts",
    "seed-db": "tsx scripts/seed-database.ts",
    "seed-db:clear": "tsx scripts/seed-database.ts --clear",
    "seed-db:stories": "tsx scripts/seed-database.ts --stories",
    "seed-db:stories:clear": "tsx scripts/seed-database.ts --stories --clear",
    "extract-images": "tsx scripts/extract-images.ts",
    "generate-stories": "tsx scripts/generate-stories.ts",
    "seed-images": "tsx scripts/seed-images.ts",
    "seed-images:clear": "tsx scripts/seed-images.ts --clear",
    "seed-translations": "tsx scripts/seed-translations.ts",
    "seed-translations:dry": "tsx scripts/seed-translations.ts --dry-run",
    "seed-all": "npm run seed-images && npm run seed-db",
    "seed-all:clear": "npm run seed-images:clear && npm run seed-db:clear",
    "setup-elevenlabs": "tsx scripts/setup-elevenlabs-agents.ts",
    "agents:pull": "tsx scripts/elevenlabs-scoped-ops.ts agent pull",
    "agents:push": "tsx scripts/elevenlabs-scoped-ops.ts agent push",
    "agents:push:dry": "tsx scripts/elevenlabs-scoped-ops.ts agent push:dry",
    "agents:status": "tsx scripts/elevenlabs-scoped-ops.ts agent status",
    "tools:pull": "tsx scripts/elevenlabs-scoped-ops.ts tool pull",
    "tools:push": "tsx scripts/elevenlabs-scoped-ops.ts tool push",
    "tools:push:dry": "tsx scripts/elevenlabs-scoped-ops.ts tool push:dry",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@elevenlabs/react": "^1.15.2",
    "@paypal/paypal-server-sdk": "2.5.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/core": "^10.74.0",
    "@sentry/nextjs": "^10.74.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^9.17.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "posthog-js": "^1.434.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "22.6.2",
    "tailwind-merge": "^3.7.0",
    "voyageai": "^0.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.6",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "twitter-api-v2": "^1.29.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "overrides": {
    "undici": "7.30.0",
    "qs": ">=6.15.2",
    "minimatch": ">=10.2.1",
    "brace-expansion": ">=5.0.12",
    "fast-uri": "4.1.5",
    "browserslist": "4.28.9",
    "js-yaml": "4.3.2",
    "fflate": "0.4.9",
    "baseline-browser-mapping": "2.11.23",
    "@humanfs/node": "0.16.8",
    "sharp": "$sharp",
    "postcss": "$postcss",
    "uuid": ">=14.0.0",
    "esbuild": ">=0.28.1",
    "protobufjs": ">=8.6.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "packageManager": "npm@11.4.0"
}
