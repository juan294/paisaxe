{
  "name": "paisaxe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev",
    "build": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build",
    "start": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "process-pdfs": "tsx scripts/process-pdfs.ts",
    "seed-db": "tsx scripts/seed-database.ts",
    "seed-db:clear": "tsx scripts/seed-database.ts --clear",
    "seed-db:stories": "tsx scripts/seed-database.ts --stories",
    "seed-db:stories:clear": "tsx scripts/seed-database.ts --stories --clear",
    "extract-images": "tsx scripts/extract-images.ts",
    "generate-stories": "tsx scripts/generate-stories.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.47.10",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "canvas": "^3.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.563.0",
    "next": "^16.1.4",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.4.168",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.4.0",
    "voyageai": "^0.1.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.4",
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.1.4",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "knip": "^5.82.1",
    "lint-staged": "^16.2.7",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.0"
  }
}
