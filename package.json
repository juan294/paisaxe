{
  "name": "paisaxe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev",
    "build": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build",
    "build:analyze": "ANALYZE=true NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build",
    "start": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=qa-journey",
    "test:e2e:ui": "playwright test --ui --project=desktop --project=mobile",
    "test:e2e:headed": "playwright test --headed --project=desktop --project=mobile",
    "test:e2e:debug": "playwright test --debug --project=desktop --project=mobile",
    "test:e2e:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:e2e:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "test:qa": "vitest run --config vitest.config.qa.ts --reporter=verbose",
    "process-pdfs": "tsx scripts/process-pdfs.ts",
    "seed-db": "tsx scripts/seed-database.ts",
    "seed-db:clear": "tsx scripts/seed-database.ts --clear",
    "seed-db:stories": "tsx scripts/seed-database.ts --stories",
    "seed-db:stories:clear": "tsx scripts/seed-database.ts --stories --clear",
    "extract-images": "tsx scripts/extract-images.ts",
    "generate-stories": "tsx scripts/generate-stories.ts",
    "seed-images": "tsx scripts/seed-images.ts",
    "seed-images:clear": "tsx scripts/seed-images.ts --clear",
    "seed-translations": "tsx scripts/seed-translations.ts",
    "seed-translations:dry": "tsx scripts/seed-translations.ts --dry-run",
    "seed-all": "npm run seed-images && npm run seed-db",
    "seed-all:clear": "npm run seed-images:clear && npm run seed-db:clear",
    "setup-elevenlabs": "tsx scripts/setup-elevenlabs-agents.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@elevenlabs/react": "^0.14.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.342.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "resend": "^6.9.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "tailwind-merge": "^3.0.0",
    "voyageai": "^0.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@next/eslint-plugin-next": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.0",
    "dotenv": "^17.2.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^5.83.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "twitter-api-v2": "^1.29.0",
    "vitest": "^4.0.0"
  },
  "optionalDependencies": {
    "canvas": "^3.2.1"
  },
  "overrides": {
    "qs": ">=6.14.1"
  }
}
