{
  "name": "paisaxe",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev",
    "build": "next build",
    "analyze": "ANALYZE=true NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build",
    "build:analyze": "ANALYZE=true NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "check-env": "tsx scripts/check-env.ts",
    "check-migrations": "tsx scripts/check-migrations.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=qa-journey",
    "test:e2e:ui": "playwright test --ui --project=desktop --project=mobile",
    "test:e2e:headed": "playwright test --headed --project=desktop --project=mobile",
    "test:e2e:debug": "playwright test --debug --project=desktop --project=mobile",
    "test:e2e:dev": "PLAYWRIGHT_USE_DEV_SERVER=true PLAYWRIGHT_REUSE_SERVER=true playwright test --project=desktop --project=mobile --project=qa-journey",
    "test:e2e:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:e2e:stripe": "tsx scripts/run-stripe-e2e.ts",
    "test:e2e:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "test:qa": "vitest run --config vitest.config.qa.ts --reporter=verbose",
    "process-pdfs": "tsx scripts/process-pdfs.ts",
    "seed-db": "tsx scripts/seed-database.ts",
    "seed-db:clear": "tsx scripts/seed-database.ts --clear",
    "seed-db:stories": "tsx scripts/seed-database.ts --stories",
    "seed-db:stories:clear": "tsx scripts/seed-database.ts --stories --clear",
    "extract-images": "tsx scripts/extract-images.ts",
    "generate-stories": "tsx scripts/generate-stories.ts",
    "seed-images": "tsx scripts/seed-images.ts",
    "seed-images:clear": "tsx scripts/seed-images.ts --clear",
    "seed-translations": "tsx scripts/seed-translations.ts",
    "seed-translations:dry": "tsx scripts/seed-translations.ts --dry-run",
    "seed-all": "npm run seed-images && npm run seed-db",
    "seed-all:clear": "npm run seed-images:clear && npm run seed-db:clear",
    "setup-elevenlabs": "tsx scripts/setup-elevenlabs-agents.ts",
    "agents:pull": "elevenlabs agents pull --all",
    "agents:push": "elevenlabs agents push",
    "agents:push:dry": "elevenlabs agents push --dry-run",
    "agents:status": "elevenlabs agents status",
    "tools:pull": "elevenlabs tools pull --all",
    "tools:push": "elevenlabs tools push",
    "tools:push:dry": "elevenlabs tools push --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@elevenlabs/react": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/core": "^10.51.0",
    "@sentry/nextjs": "^10.51.0",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.2.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@tailwindcss/typography": "^0.5.19",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "posthog-js": "^1.372.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0",
    "voyageai": "0.1.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@next/eslint-plugin-next": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.6",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.5.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "twitter-api-v2": "^1.29.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "overrides": {
    "qs": ">=6.14.2",
    "minimatch": ">=10.2.1",
    "brace-expansion": ">=5.0.6",
    "postcss": "^8.5.10",
    "uuid": ">=14.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "> 0.5%, not dead"
  ],
  "packageManager": "npm@11.4.0"
}
