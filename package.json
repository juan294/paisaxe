{
  "name": "paisaxe",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev --port 3006",
    "build": "next build",
    "analyze": "ANALYZE=true NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build --webpack",
    "build:analyze": "ANALYZE=true NODE_OPTIONS='--disable-warning=ExperimentalWarning' next build --webpack",
    "start": "next start",
    "lint": "npm run lint:src && npm run lint:scripts",
    "lint:src": "eslint src/",
    "lint:scripts": "eslint scripts --max-warnings=0",
    "typecheck": "npm run typecheck:app && npm run typecheck:scripts && npm run typecheck:e2e && npm run typecheck:edge",
    "typecheck:app": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck:edge": "tsc --noEmit -p supabase/functions/tsconfig.json",
    "check-verification-coverage": "tsx scripts/check-verification-coverage.ts",
    "check-env": "tsx scripts/check-env.ts",
    "check-migrations": "tsx scripts/check-migrations.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=qa-journey",
    "test:e2e:ui": "playwright test --ui --project=desktop --project=mobile",
    "test:e2e:headed": "playwright test --headed --project=desktop --project=mobile",
    "test:e2e:debug": "playwright test --debug --project=desktop --project=mobile",
    "test:e2e:dev": "PLAYWRIGHT_USE_DEV_SERVER=true PLAYWRIGHT_REUSE_SERVER=true playwright test --project=desktop --project=mobile --project=qa-journey",
    "test:e2e:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "test:e2e:stripe": "tsx scripts/run-stripe-e2e.ts",
    "prelaunch": "tsx scripts/run-prelaunch-gate.ts",
    "prelaunch:live": "REQUIRE_LIVE_INTEGRATION=true npm run test:e2e:stripe",
    "test:e2e:visual:update": "playwright test --project=visual-desktop --project=visual-mobile --update-snapshots",
    "test:qa": "vitest run --config vitest.config.qa.ts --reporter=verbose",
    "process-pdfs": "tsx scripts/process-pdfs.ts",
    "seed-db": "tsx scripts/seed-database.ts",
    "seed-db:clear": "tsx scripts/seed-database.ts --clear",
    "seed-db:stories": "tsx scripts/seed-database.ts --stories",
    "seed-db:stories:clear": "tsx scripts/seed-database.ts --stories --clear",
    "extract-images": "tsx scripts/extract-images.ts",
    "generate-stories": "tsx scripts/generate-stories.ts",
    "seed-images": "tsx scripts/seed-images.ts",
    "seed-images:clear": "tsx scripts/seed-images.ts --clear",
    "seed-translations": "tsx scripts/seed-translations.ts",
    "seed-translations:dry": "tsx scripts/seed-translations.ts --dry-run",
    "seed-all": "npm run seed-images && npm run seed-db",
    "seed-all:clear": "npm run seed-images:clear && npm run seed-db:clear",
    "setup-elevenlabs": "tsx scripts/setup-elevenlabs-agents.ts",
    "agents:pull": "elevenlabs agents pull --all",
    "agents:push": "elevenlabs agents push",
    "agents:push:dry": "elevenlabs agents push --dry-run",
    "agents:status": "elevenlabs agents status",
    "tools:pull": "elevenlabs tools pull --all",
    "tools:push": "elevenlabs tools push",
    "tools:push:dry": "elevenlabs tools push --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@elevenlabs/react": "^1.6.5",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@sentry/core": "^10.57.0",
    "@sentry/nextjs": "^10.57.0",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/typography": "^0.5.20",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.9",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "posthog-js": "^1.384.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.12.4",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "voyageai": "0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@next/eslint-plugin-next": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.6",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.16.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.0.227",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "twitter-api-v2": "^1.29.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "overrides": {
    "qs": ">=6.15.2",
    "minimatch": ">=10.2.1",
    "brace-expansion": ">=5.0.6",
    "postcss": "^8.5.15",
    "uuid": ">=14.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "packageManager": "npm@11.4.0"
}
