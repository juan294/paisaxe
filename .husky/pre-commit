#!/bin/sh

echo "Running pre-commit checks..."

# On Apple Silicon Macs, force arm64 architecture to avoid Rosetta issues
# (x86_64 git binary can cause native module architecture mismatches)
ARCH_PREFIX=""
if [ "$(uname -s)" = "Darwin" ]; then
  # Check if this is Apple Silicon by looking at CPU brand
  CPU_BRAND=$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo "")
  if echo "$CPU_BRAND" | grep -q "Apple"; then
    ARCH_PREFIX="arch -arm64"
  fi
fi

# Run typecheck
echo "→ TypeScript check..."
$ARCH_PREFIX npm run typecheck || exit 1

# Run lint
echo "→ ESLint check..."
$ARCH_PREFIX npm run lint || exit 1

# Run tests
echo "→ Running tests..."
$ARCH_PREFIX npm run test || exit 1

# Run dead-code detection (FE-M5, #767): CI's knip job only runs on
# pull_request/push to develop, which can't block a commit that has
# already landed. Gating here (like typecheck/lint/test above) is what
# actually enforces "no dead code" for this repo's direct-to-develop,
# no-PR workflow.
echo "→ Knip dead-code check..."
$ARCH_PREFIX npx knip || exit 1

echo "✓ All checks passed!"
