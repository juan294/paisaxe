{
    "type": "webhook",
    "name": "save_favorite",
    "description": "Save (bookmark) a place to the visitor's saved places so they can find it later. Use this when the visitor asks you to remember, save, or bookmark a place (e.g. 'guárdame ese restaurante', 'apunta ese sitio'). Use the place name (and address/place_id if you have them from search_places).",
    "response_timeout_secs": 20,
    "disable_interruptions": false,
    "force_pre_tool_speech": false,
    "assignments": [],
    "tool_call_sound_behavior": "auto",
    "tool_error_handling_mode": "auto",
    "dynamic_variables": {
        "dynamicVariablePlaceholders": {}
    },
    "execution_mode": "immediate",
    "api_schema": {
        "request_headers": {
            "Content-Type": "application/json",
            "x-mcp-secret": {
                "secret_id": "RjXEp57KRMAgOoZiAUdU"
            }
        },
        "url": "https://paisaxe.es/api/mcp/save-favorite",
        "method": "POST",
        "path_params_schema": {},
        "request_body_schema": {
            "type": "object",
            "required": [
                "place_name"
            ],
            "description": "The place the visitor wants to bookmark. Use the name (and address/place_id from search_places when available).",
            "properties": {
                "place_name": {
                    "type": "string",
                    "description": "Name of the place to save (e.g. 'Casa Marcial', 'Mirador del Fito')",
                    "is_system_provided": false,
                    "dynamic_variable": "",
                    "constant_value": ""
                },
                "place_address": {
                    "type": "string",
                    "description": "Optional: address of the place, from search_places",
                    "is_system_provided": false,
                    "dynamic_variable": "",
                    "constant_value": ""
                },
                "place_id": {
                    "type": "string",
                    "description": "Optional: Google place_id from search_places",
                    "is_system_provided": false,
                    "dynamic_variable": "",
                    "constant_value": ""
                },
                "notes": {
                    "type": "string",
                    "description": "Optional: a short note about why the visitor wants to remember this place",
                    "is_system_provided": false,
                    "dynamic_variable": "",
                    "constant_value": ""
                },
                "conversation_id": {
                    "type": "string",
                    "description": "Conversation id used to group the visitor's saved places",
                    "is_system_provided": true,
                    "dynamic_variable": "system__conversation_id",
                    "constant_value": ""
                }
            }
        },
        "content_type": "application/json"
    }
}
